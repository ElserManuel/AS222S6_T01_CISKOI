					"params": {
						"approved": "Dirección aprobada",
						"approver": "Dirección que realiza la aprobación",
						"status": "Estado de aprobación (true/false)"
					}
				},
				"Deposit(address,uint256,uint256)": {
					"params": {
						"amount": "Cantidad de ETH recibida (en wei)",
						"balance": "Saldo actualizado después del depósito",
						"sender": "Dirección que envía el ETH"
					}
				},
				"SettingChanged(address,string,bytes)": {
					"params": {
						"changedBy": "Dirección que realizó el cambio",
						"newValue": "Nuevo valor (codificado como bytes)",
						"settingName": "Nombre de la configuración cambiada"
					}
				},
				"Transfer(address,uint256,string,uint256)": {
					"params": {
						"amount": "Cantidad de ETH enviada (en wei)",
						"description": "Descripción opcional de la transacción",
						"receiver": "Dirección que recibe el ETH",
						"transactionId": "ID de la transacción en el historial"
					}
				}
			},
			"kind": "dev",
			"methods": {
				"approveAddress(address,bool)": {
					"params": {
						"_address": "Dirección a aprobar o desaprobar",
						"_approved": "Estado de aprobación"
					}
				},
				"constructor": {
					"details": "Inicializa los límites diarios y otras configuraciones"
				},
				"emergencyWithdraw(address)": {
					"params": {
						"_to": "Dirección a la que se transferirán los fondos"
					}
				},
				"getBalance()": {
					"returns": {
						"_0": "balance ETH disponible en wei"
					}
				},
				"getTransactionHistory()": {
					"returns": {
						"_0": "Arreglo de todas las transacciones realizadas"
					}
				},
				"sendEther(address,uint256,string)": {
					"details": "Verifica límites diarios y actualiza el historial de transacciones",
					"params": {
						"_amount": "Cantidad de ETH a transferir en wei",
						"_description": "Descripción opcional de la transacción",
						"_to": "Dirección a la que se enviará el ETH"
					},
					"returns": {
						"_0": "transactionId ID de la transacción en el historial"
					}
				},
				"setBackupOwner(address)": {
					"params": {
						"_backupOwner": "Dirección del propietario de respaldo"
					}
				},
				"setDailyLimit(uint256)": {
					"params": {
						"_limit": "Nuevo límite diario en wei"
					}
				},
				"setMultiSigEnabled(bool)": {
					"params": {
						"_enabled": "Estado de la funcionalidad multifirma"
					}
				}
			},
			"title": "Ciskoi Wallet - Contrato inteligente de billetera descentralizada en Ethereum",
			"version": 1
		},
		"userdoc": {
			"events": {
				"AddressApprovalChanged(address,address,bool)": {
					"notice": "Evento que registra la aprobación de una dirección para transacciones multifirma"
				},
				"Deposit(address,uint256,uint256)": {
					"notice": "Evento que registra un depósito de ETH en la billetera"
				},
				"SettingChanged(address,string,bytes)": {
					"notice": "Evento que registra un cambio en la configuración de la billetera"
				},
				"Transfer(address,uint256,string,uint256)": {
					"notice": "Evento que registra un envío de ETH desde la billetera"
				}
			},
			"kind": "user",
			"methods": {
				"approveAddress(address,bool)": {
					"notice": "Aprueba o desaprueba una dirección para transacciones multifirma"
				},
				"constructor": {
					"notice": "Se asigna como propietario a quien despliega el contrato"
				},
				"emergencyWithdraw(address)": {
					"notice": "Función de emergencia que permite al propietario transferir todos los fondos"
				},
				"getBalance()": {
					"notice": "Devuelve el saldo actual en el contrato inteligente"
				},
				"getTransactionHistory()": {
					"notice": "Devuelve el historial completo de transacciones"
				},
				"sendEther(address,uint256,string)": {
					"notice": "Permite al propietario enviar ETH a otra dirección"
				},
				"setBackupOwner(address)": {
					"notice": "Permite al propietario configurar un propietario de respaldo"
				},
				"setDailyLimit(uint256)": {
					"notice": "Permite al propietario establecer un límite diario de gasto"
				},
				"setMultiSigEnabled(bool)": {
					"notice": "Activa o desactiva la funcionalidad de multifirma"
				}
			},
			"notice": "Este contrato permite administrar ETH de forma segura con características adicionales de seguridad",
			"version": 1
		}
